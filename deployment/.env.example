# Copy this file to .env and fill in the values
# cp .env.example .env

# ── Portainer ─────────────────────────────────────────────────────────────────
PORTAINER_URL=https://portainer.sanvx.online
PORTAINER_USERNAME=admin
PORTAINER_PASSWORD=your_portainer_password

# ── App secrets ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=change_me_to_a_32_char_min_secret_key

# ── Database ──────────────────────────────────────────────────────────────────
DB_PASSWORD=your_db_password
DB_USER=proc
DB_NAME=procurelink

# ── Deployment ────────────────────────────────────────────────────────────────
STACK_NAME=procurelink
ENDPOINT_ID=1
APP_URL=http://localhost
PORT=80
